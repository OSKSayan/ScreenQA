<Window x:Class="ScreenQA.Views.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenQA — выделение области"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Black" Cursor="Cross"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">
    <Grid x:Name="Root">
        <!-- «Замороженный» снимок монитора, сделанный в момент нажатия горячей клавиши -->
        <Image x:Name="Snapshot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <!-- Затемнение с «дыркой» под выделением -->
        <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False"/>

        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="SelectionBorder" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/>
            <Rectangle x:Name="SelectionAccent" Stroke="#4C6EF5" StrokeThickness="1.5" StrokeDashArray="4 4" Visibility="Collapsed"/>
            <Border x:Name="SizeBadge" Background="#E61F2328" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="11"/>
            </Border>
        </Canvas>

        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0"
                Background="#E61F2328" CornerRadius="8" Padding="16,9" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="14" Text="Выделите область с вопросом"/>
                <TextBlock Foreground="#ADB5BD" FontSize="14" Text="   ·   Esc или правая кнопка мыши — отмена"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
