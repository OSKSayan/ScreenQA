<Window x:Class="ScreenQA.Views.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenQA — разбор вопроса"
        Width="440" Height="540" MinWidth="320" MinHeight="260"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" WindowStyle="ToolWindow"
        WindowStartupLocation="Manual"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и статус защиты от записи -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Border x:Name="CaptureChip" DockPanel.Dock="Right" CornerRadius="10" Padding="8,3"
                    Background="#E9ECEF" VerticalAlignment="Center" ToolTipService.ShowDuration="20000">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="CaptureDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Gray"/>
                    <TextBlock x:Name="CaptureText" FontSize="11" VerticalAlignment="Center" Text="…"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Разбор вопроса" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Ход работы / ошибка -->
        <StackPanel Grid.Row="1">
            <Border x:Name="BusyPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Распознаю текст…" Margin="0,0,0,8"/>
                    <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}"/>
                </StackPanel>
            </Border>
            <Border x:Name="ErrorPanel" Style="{StaticResource Card}" Background="#FFF5F5" BorderBrush="#FFC9C9" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
                    <Button x:Name="OpenSettingsButton" Content="Открыть настройки" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="OnOpenSettings"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="ВОПРОС"/>
                            <TextBox x:Name="QuestionText" Style="{StaticResource ReadOnlyText}" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="ОТВЕТ" Foreground="{StaticResource AccentBrush}"/>
                            <TextBox x:Name="AnswerText" Style="{StaticResource ReadOnlyText}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ExplanationCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="ОБЪЯСНЕНИЕ"/>
                            <TextBox x:Name="ExplanationText" Style="{StaticResource ReadOnlyText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Expander x:Name="OcrExpander" Margin="0,2,0,0">
                    <Expander.Header>
                        <TextBlock Text="Распознанный текст — можно исправить и спросить снова" Foreground="{StaticResource MutedBrush}"/>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <TextBox x:Name="OcrTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto"/>
                        <Button x:Name="AskAgainButton" Content="Спросить ещё раз" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Click="OnAskAgain"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="SaveImageButton" DockPanel.Dock="Left" Content="Сохранить снимок…"
                    ToolTip="Сохранить выделенную область в файл PNG. Без этого снимок нигде не сохраняется."
                    Click="OnSaveImage"/>
            <Button DockPanel.Dock="Right" Content="Закрыть" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnClose"/>
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Копировать ответ" IsEnabled="False" Click="OnCopy"/>
        </DockPanel>
    </Grid>
</Window>
